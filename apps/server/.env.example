# Covibes server and worker – example values, no secrets.
# `pnpm dev` sets DATABASE_URL, DATABASE_ADMIN_URL, BETTER_AUTH_SECRET, INTERNAL_TOKEN and TOKEN_KEY itself
# (from .data/).
# Own values go into .env.local in this folder (never committed).
NODE_ENV=development
PORT=3001
# Only reachable from this machine.
HOST=127.0.0.1
# Address of the web app; the server is reachable below it under /api (Vite proxy).
APP_URL=http://localhost:5173

# Optional: sign in with GitLab. Without these values, only the login link by email is available.
# Create the application under GitLab > Preferences > Applications, scope `read_user`,
# redirect URI http://localhost:5173/api/auth/callback/gitlab
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# Only for a self-managed GitLab; defaults to gitlab.com.
# GITLAB_ISSUER=

# Optional: GitHub repository integration through your operator-owned GitHub App (separate from
# GitHub sign-in). Configure all six values together; `pnpm dev` supplies TOKEN_KEY locally.
# App OAuth callback: <APP_URL>/api/github/callback; webhook: <APP_URL>/api/github/webhook.
# Repository permissions: Contents, Issues and Pull requests read/write; Metadata read.
# Subscribe to Issues, Pull request, Push, Installation and Installation repositories events.
# GITHUB_APP_ID=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# PEM RSA key, with literal \n between lines if using one env-file line.
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_SLUG=
# Generate a separate webhook secret of at least 32 characters.
# GITHUB_APP_WEBHOOK_SECRET=

# Optional: the agents' access to Claude. Unset, the worker uses the Claude Code login on this
# machine (your Claude subscription). An instance other people use needs an API key from the
# Claude Console instead; a personal subscription must not serve others.
# ANTHROPIC_API_KEY=

# Optional: the limits of the AI, as estimated costs in USD (spec 31a). A project may cost this
# much in a calendar month, a person this much in a day across all projects; at a limit only the
# AI pauses. The defaults are 100 and 15; 0 switches a limit off.
# AI_LIMIT_PROJECT_MONTH_USD=100
# AI_LIMIT_USER_DAY_USD=15

# Spec 42: optional sign-in providers (set both values in each pair).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Production registration is closed by default. Exact emails, comma-separated; no wildcards.
# Alternatively: pnpm --filter @covibes/server beta:invite person@example.com 7
BETA_ALLOWED_EMAILS=
# Closed-beta instance allowance in USD per UTC calendar month (0 disables that limit).
# AI_LIMIT_INSTANCE_MONTH_USD=20
# Required in production: conservative maximum reservation for one gateway invocation.
# Claude SDK treats this as a soft loop cap; a provider result may exceed it. Local default: 1.
# AI_MAX_CALL_USD=1
