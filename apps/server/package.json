{
  "name": "@covibes/server",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "auth:schema": "tsx src/auth/print-schema.ts"
  },
  "dependencies": {
    "@hocuspocus/extension-database": "4.7.0",
    "@hocuspocus/server": "4.7.0",
    "@hono/node-server": "2.1.1",
    "better-auth": "1.7.6",
    "hono": "4.13.9",
    "kysely": "0.29.6",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "ws": "8.22.0",
    "yjs": "13.6.33",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@covibes/db": "workspace:*",
    "@covibes/shared": "workspace:*",
    "@hocuspocus/provider": "4.7.0",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
