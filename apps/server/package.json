{
  "name": "@covibes/server",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/index.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/worker.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "auth:schema": "tsx src/auth/print-schema.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "@hocuspocus/extension-database": "4.7.0",
    "@hocuspocus/provider": "4.7.0",
    "@hocuspocus/server": "4.7.0",
    "@hono/node-server": "2.1.6",
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-auth": "1.7.18",
    "elkjs": "0.12.0",
    "fflate": "0.8.3",
    "graphile-worker": "0.18.0",
    "hono": "4.13.17",
    "kysely": "0.29.6",
    "nodemailer": "10.1.7",
    "pg": "8.23.0",
    "unpdf": "1.8.1",
    "ws": "8.22.0",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@covibes/db": "workspace:*",
    "@covibes/shared": "workspace:*",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
