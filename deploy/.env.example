# Covibes: settings for deploy/compose.yaml. Copy to deploy/.env (never committed) and fill in.
# Generate every secret with:   openssl rand -hex 32
# Hex values are safe inside connection URLs; do not use characters like @ : / # in passwords.

# Public address of Covibes, exactly as people open it (with https://, without a slash at the end).
APP_URL=https://covibes.example.org

# Secret for the login sessions (at least 32 characters).
BETTER_AUTH_SECRET=

# Shared secret of the app and the worker (at least 32 characters).
INTERNAL_TOKEN=

# Optional instance-funded provider keys. Workspace owners may instead provide their own keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Database: superuser of the PostgreSQL container, and the two roles Covibes uses.
POSTGRES_PASSWORD=
COVIBES_ADMIN_PASSWORD=
COVIBES_APP_PASSWORD=

# --- Sign-in: at least one of the two ways must be set up, otherwise Covibes does not start. ---

# 1) Login link by mail over SMTP, e.g. smtps://user:password@mail.example.org:465
#    Special characters in user or password must be URL-encoded (@ becomes %40).
SMTP_URL=
MAIL_FROM=Covibes <no-reply@example.org>

# 2) Sign in with GitLab: OAuth application with scope read_user and the redirect URI
#    <APP_URL>/api/auth/callback/gitlab
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# --- Repositories: projects connect their GitLab repository (optional). ---

# The OAuth application above also needs the scope api and a second redirect URI:
#    <APP_URL>/api/git/callback
# This key seals repository tokens and workspace provider keys (at least 32 characters). Keep it:
# changing it makes existing encrypted credentials unreadable.
TOKEN_KEY=

# --- Optional ---

# The limits of the AI, as estimated costs in USD: what one project may cost in a calendar month,
# and one person in a day across all projects. At a limit only the AI pauses. Empty means the
# defaults (100 and 15); 0 switches a limit off.
AI_LIMIT_PROJECT_MONTH_USD=
AI_LIMIT_USER_DAY_USD=

# Addresses of reverse proxies that append to X-Forwarded-For, comma-separated.
TRUSTED_PROXIES=
# Where the app container listens on this server (default 127.0.0.1:3000, only for the web server).
COVIBES_BIND=127.0.0.1
COVIBES_PORT=3000

# Instance AI allowance in USD per UTC month; 0 disables the instance limit.
AI_LIMIT_INSTANCE_MONTH_USD=20
# Conservative reservation per invocation; required for production AI calls.
# The Claude SDK cap is soft and cannot guarantee the provider's final invoice.
AI_MAX_CALL_USD=1
