# Covibes: settings for deploy/compose.yaml. Copy to deploy/.env (never committed) and fill in.
# Generate every secret with:   openssl rand -hex 32
# Hex values are safe inside connection URLs; do not use characters like @ : / # in passwords.

# Public address of Covibes, exactly as people open it (with https://, without a slash at the end).
APP_URL=https://covibes.example.org

# Secret for the login sessions (at least 32 characters).
BETTER_AUTH_SECRET=

# Database: superuser of the PostgreSQL container, and the two roles Covibes uses.
POSTGRES_PASSWORD=
COVIBES_ADMIN_PASSWORD=
COVIBES_APP_PASSWORD=

# --- Sign-in: at least one of the two ways must be set up, otherwise Covibes does not start. ---

# 1) Login link by mail over SMTP, e.g. smtps://user:password@mail.example.org:465
#    Special characters in user or password must be URL-encoded (@ becomes %40).
SMTP_URL=
MAIL_FROM=Covibes <no-reply@example.org>

# 2) Sign in with GitLab: OAuth application with scope read_user and the redirect URI
#    <APP_URL>/api/auth/callback/gitlab
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# --- Optional ---

# Addresses of reverse proxies that append to X-Forwarded-For, comma-separated.
TRUSTED_PROXIES=
# Where the app container listens on this server (default 127.0.0.1:3000, only for the web server).
COVIBES_BIND=127.0.0.1
COVIBES_PORT=3000
